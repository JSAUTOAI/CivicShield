# =============================================================================
# CIVICSHIELD ENVIRONMENT CONFIGURATION
# =============================================================================
# NEVER commit this file. It is in .gitignore - keep it that way.
# Back it up in your password manager (Bitwarden secure note).
#
# -----------------------------------------------------------------------------
# TEMPLATE - copy to .env and fill in. Real values live in .env (gitignored).
# -----------------------------------------------------------------------------
#   [OK]      DATABASE_URL, NEXTAUTH_*, RESEND_API_KEY, EMAIL_*, STRIPE_*
#   [ACTION]  ANTHROPIC_API_KEY ..... key is valid, but the ACCOUNT HAS NO
#                                     CREDIT. Nothing to paste - you need to
#                                     TOP UP. See section A.
#   [TODO]    RESEND_WEBHOOK_SECRET   empty - see section B2
#   [TODO]    AWS_ACCESS_KEY_ID       empty - see section C
#   [TODO]    AWS_SECRET_ACCESS_KEY   empty - see section C
#
# IMPORTANT: anything you change here must ALSO be added in Vercel, or it only
# works on your PC:
#     vercel.com -> CivicShield -> Settings -> Environment Variables
#     (tick Production + Preview + Development, then Deployments -> Redeploy)
# =============================================================================


# =============================================================================
# A.  AI ANALYSIS          >>> ACTION NEEDED: TOP UP CREDIT <<<
# =============================================================================
# This powers the whole "analyse my issue -> generate complaint" feature.
#
# Your key is FINE. The ACCOUNT BALANCE is empty, which is why analysis is
# failing right now. The API replies:
#     "Your credit balance is too low to access the Anthropic API"
#
# TO FIX - there is nothing to paste into this file:
#   1. Go to   https://console.anthropic.com/settings/billing
#   2. Add credit, and turn ON auto-reload so it cannot run dry again
#   3. Done - analysis works immediately, no redeploy needed
#
# Cost is roughly 8-10p per complaint generated, so ~GBP 10 goes a long way at
# your current volume. Auto-reload is the setting worth switching on.
ANTHROPIC_API_KEY=""


# =============================================================================
# B.  RESEND (email)       >>> ONE VALUE TO PASTE IN <<<
# =============================================================================
# Dashboard: https://resend.com
#
# ---- B1. API key - already set, leave alone unless you rotate it -----------
#      Where it came from: Resend -> API Keys
RESEND_API_KEY=""

# ---- B2. WEBHOOK SIGNING SECRET  <<< PASTE HERE (currently empty) ----------
#
#  WHAT IT DOES: proves an incoming webhook genuinely came from Resend.
#  Until it is set, anyone who sends the right header names could fake
#  "your complaint was opened" or "they replied" into your data.
#
#  STEP 1 - check these TWO webhooks exist:  Resend -> Webhooks -> Add Webhook
#
#           Webhook 1  (delivery + open tracking)
#             URL:     https://www.civicshield.co.uk/api/email/events
#             Events:  email.sent, email.delivered, email.opened,
#                      email.bounced, email.complained
#
#           Webhook 2  (replies coming back in)
#             URL:     https://www.civicshield.co.uk/api/email/inbound
#             Events:  email.received      (needs inbound parsing enabled)
#
#  STEP 2 - open a webhook, copy its "Signing Secret" (begins with  whsec_ )
#  STEP 3 - paste it between the quotes on the line below
#  STEP 4 - add the SAME value in Vercel, then redeploy
#
#  If the two webhooks give DIFFERENT signing secrets, tell me and I will split
#  this into two variables - the code currently expects one.
RESEND_WEBHOOK_SECRET=""

# ---- B3. Sending addresses - already correct, leave alone -----------------
EMAIL_FROM="CivicShield <complaints@civicshield.co.uk>"
EMAIL_NOREPLY="CivicShield <noreply@civicshield.co.uk>"
EMAIL_INBOUND_DOMAIN="civicshield.co.uk"


# =============================================================================
# C.  AWS S3 (evidence uploads)     >>> TWO VALUES TO PASTE IN <<<
# =============================================================================
# Until these are filled in, a user attaching photos or documents to a
# complaint gets a clear "uploads unavailable" message, and their issue still
# saves normally. Nothing is lost - the feature is simply off.
#
# FULL CLICK-BY-CLICK WALKTHROUGH:  S3-SETUP-GUIDE.md  (same folder as this file)
#
# Short version:
#   1. https://s3.console.aws.amazon.com/s3/buckets  ->  Create bucket
#          name:   civicshield-evidence
#          region: EU (London) eu-west-2
#          leave "Block all public access" TICKED
#   2. Bucket -> Permissions -> CORS -> paste the JSON from S3-SETUP-GUIDE.md
#          It MUST include  https://www.civicshield.co.uk  (with the www),
#          otherwise uploads work on your PC and fail for every real user.
#   3. https://console.aws.amazon.com/iam  ->  Users  ->  Create user
#          name: civicshield-s3, attach the bucket-scoped policy from the guide
#   4. That user -> Security credentials -> Create access key
#          -> "Application running outside AWS"
#   5. Paste the two values below. THE SECRET IS SHOWN ONLY ONCE - copy it now.
#   6. Add both in Vercel as well, then redeploy.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="eu-west-2"
AWS_S3_BUCKET="civicshield-evidence"


# =============================================================================
# D.  DATABASE - set, do not touch
# =============================================================================
# Railway PostgreSQL. Losing this string loses access to all 29 users and every
# complaint. It is the single most important line in this file.
DATABASE_URL=""


# =============================================================================
# E.  AUTH - set, do not touch
# =============================================================================
# NEXTAUTH_URL below is localhost, which is correct for your PC.
# Vercel has its own separate value of https://www.civicshield.co.uk
# Do NOT put localhost into Vercel.
NEXTAUTH_URL="http://localhost:3001"
# Changing this secret logs out every user immediately.
NEXTAUTH_SECRET=""


# =============================================================================
# F.  STRIPE - set, LIVE keys (real money)
# =============================================================================
# Dashboard: https://dashboard.stripe.com
# These are LIVE keys, not test keys. Charges are real.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""

# Signing secret for   https://www.civicshield.co.uk/api/stripe/webhook
# Stripe -> Developers -> Webhooks -> your endpoint -> Signing secret
STRIPE_WEBHOOK_SECRET=""

# Price IDs - Stripe -> Product catalogue. Must match the tiers defined in
# src/lib/subscription.ts  (Basic 4.99 / Pro 14.99 / Agency 19.99 per month).
STRIPE_BASIC_MONTHLY_PRICE_ID=""
STRIPE_PRO_MONTHLY_PRICE_ID=""
STRIPE_AGENCY_MONTHLY_PRICE_ID=""


# =============================================================================
# NOTE - a stray value that used to be here
# =============================================================================
# A loose whsec_ value once sat at the bottom of the real .env file, not
# attached to any variable name, so nothing ever read it. It was most likely a
# webhook signing secret pasted into the wrong place. It has been removed.
# If something webhook-related stops working, check whether it belonged to
# STRIPE_WEBHOOK_SECRET (section F) or RESEND_WEBHOOK_SECRET (section B2).

